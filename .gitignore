# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.local.example
out/
dev.log

# 포켓몬 작업 폴더 — 이 PC 에서만 쓰는 이미지·결과(로컬 전용, 서버·git 에 안 올린다)
/pokemon/

# 임시 점검 스크립트 (서브에이전트/수동 확인용)
_chk*.mjs
*.tmp.json

# 프롬프트 고정 테스트의 이번 실행 결과 (기준본 regress/snapshots 는 커밋한다)
/regress/out/
