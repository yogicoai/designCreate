# ── imgCreate — 자사몰 이미지 생성 프로그램 ──────────────────────────
# 실제 값은 .env.local 에 (git 제외). Vercel 배포 시 동일 키를 Project Settings > Environment Variables 에 등록.

# MongoDB — 자산 레지스트리 + 생성 이력
MONGODB_URI=mongodb://<user>:<pw>@<hosts>/?ssl=true&authSource=admin&replicaSet=<rs>
MONGODB_DB=imgcreate

# Google Gemini — 나노바나나 이미지 생성
GEMINI_API_KEY=
# 기본=Pro(2K 네이티브·₩188/장) / 초안=flash(대량 탐색용·₩141/장)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_MODEL_DRAFT=gemini-3.1-flash-image

# Cafe24 FTP — 생성물 영구 저장 (공개 URL 발급)
FTP_HOST=yogibo.ftp.cafe24.com
FTP_PORT=21
FTP_USER=
FTP_PASS=
# 업로드 루트 — 생성물은 이 아래 그날 날짜(YYYY-MM-DD) 폴더로 들어간다
FTP_REMOTE_DIR=/web/design
FTP_PUBLIC_BASE=https://yogibo.openhost.cafe24.com/web/design

# 생성 한도 — 비용 사고 방지. 관리자 화면에서 조정 가능.
GEMINI_USAGE_LIMIT=300
# 목표 해상도 — Pro는 2K 네이티브 지원(업스케일 불필요)
GEMINI_IMAGE_SIZE=2K

# Claude — 모든 생성 프롬프트를 Opus 가 작성한다
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# 프롬프트 작성 모드 — local(템플릿 조립, 무과금) / opus(Claude Opus 작성, 라이브)
PROMPT_MODE=local

# Higgsfield — Element 토큰(제품 락) 기반 생성 엔진 (선택)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_IMAGE_MODEL=soul

# 힉스필드 1장당 크레딧 (운영 실사용 기준 Soul=2)
HIGGSFIELD_CREDITS_PER_IMAGE=2
